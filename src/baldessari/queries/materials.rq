PREFIX cps: <https://cps.tibwiki.io/entity/>
PREFIX cpsd: <https://cps.tibwiki.io/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Materials (type Q5) with the number of works that use them (P10).
SELECT ?item (SAMPLE(?l) AS ?label) (SAMPLE(?aat) AS ?aat) (SAMPLE(?wd) AS ?wikidata)
       (COUNT(DISTINCT ?work) AS ?works)
WHERE {
  ?item cpsd:P3 cps:Q5 .
  OPTIONAL { ?item rdfs:label ?l . FILTER(LANG(?l) = "en") }
  OPTIONAL { ?item cpsd:P26 ?aat }
  OPTIONAL { ?item cpsd:P24 ?wd }
  OPTIONAL { ?work cpsd:P10 ?item }
}
GROUP BY ?item
ORDER BY DESC(?works) ?label
